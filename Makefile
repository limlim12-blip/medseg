.PHONY: data
PYTHON ?= $(if $(wildcard .venv/bin/python),.venv/bin/python,python)
CKPT   ?= saved/models/medseg/RUN_ID/checkpoint-epoch5.pth

help:  ## Show help
	@grep -E '^[.a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-30s\033[0m %s\n", $$1, $$2}'

clean: ## Clean autogenerated files
	rm -rf dist
	find . -type f -name "*.DS_Store" -ls -delete
	find . | grep -E "(__pycache__|\.pyc|\.pyo)" | xargs rm -rf
	find . | grep -E ".pytest_cache" | xargs rm -rf
	find . | grep -E ".ipynb_checkpoints" | xargs rm -rf
	rm -f .coverage

clean-logs: ## Clean logs
	rm -rf logs/**

format: ## Run pre-commit hooks
	pre-commit run -a

sync: ## Merge changes from main branch to your current branch
	git pull
	git pull origin main

data: ## Download Kvasir-SEG (Kaggle) into data/kvasir-seg
	$(PYTHON) data_loader/dataset.py --dir data/kvasir-seg

train: ## Train with config.json (extra flags: make train ARGS="--bs 16 --lr 3e-4")
	$(PYTHON) main.py $(ARGS)

train-cloud: ## Train using the system python
	python main.py $(ARGS)

resume: ## Resume training (make resume CKPT=saved/models/<name>/<run_id>/checkpoint-epoch5.pth)
	$(PYTHON) main.py --resume="$(CKPT)"

test: ## Evaluate a checkpoint on the test split (make test CKPT=.../model_best.pth)
	$(PYTHON) test.py --resume="$(CKPT)"

segformer: ## Train SegFormer (make segformer SEGFORMER=nvidia/mit-b2)
	$(PYTHON) main.py --model segformer --segformer_name $(or $(SEGFORMER),nvidia/mit-b0) $(ARGS)

sam: ## Zero-shot SAM evaluation on the test split (make sam ARGS="--data_dir data/kvasir-seg --prompt box")
	$(PYTHON) sam_eval.py $(ARGS)

visualize: ## Plot curves + predictions (make visualize RUN=saved/models/<name>/<run_id>)
	$(PYTHON) visualize.py --run="$(RUN)"

wandb:
	wandb server start --port 8088
